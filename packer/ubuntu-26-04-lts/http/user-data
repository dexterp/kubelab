#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: ubuntu-server
    username: packer
    password: $6$b5CxmcCZAbev4gAr$k2v1a07ERxQRNbapxZuEDCQfNPAWC7MhxpSRGKa4TY0YOBXk6oLm7GtCQLTyjkJEc609IujS7.zynHEreuckT1
  storage:
    layout:
      name: lvm
      sizing-policy: all
  locale: en_US.UTF-8
  refresh-installer:
    update: true
    channel: latest/edge
  keyboard:
    layout: us
    toggle: null
    variant: ""
  source:
    id: ubuntu-server
    search_drivers: true
  network:
    version: 2
    ethernets:
      ens33:
        match:
          name: "en*"
        dhcp4: true
      eth1:
        match:
          name: "eth*"
        dhcp4: true
  apt:
    disable_components: []
    fallback: abort
    geoip: false
    mirror-selection:
      primary:
        - country-mirror
        - arches: &id001
            - amd64
            - i386
          uri: http://au.archive.ubuntu.com/ubuntu/
        - arches: &id002
            - arm64
          uri: http://ports.ubuntu.com/ubuntu-ports
    preserve_sources_list: false
    security:
      - arches: *id001
        uri: http://au.archive.ubuntu.com/ubuntu/
      - arches: *id002
        uri: http://ports.ubuntu.com/ubuntu-ports
  ssh:
    allow-pw: true
    authorized-keys: []
    install-server: true
  drivers:
    install: true
  oem:
    install: auto
  kernel:
    package: linux-generic
  updates: security
  timezone: Australia/Sydney
  packages:
    - build-essential
    - ca-certificates
    - net-tools
    - openssh-server
    - zsh
    - zsh-doc
  late-commands:
    - curtin in-target --target /target -- systemctl enable ssh.socket
    - curtin in-target --target /target -- systemctl enable ssh.service
    - curtin in-target --target /target -- useradd -m -u 1002 -s /bin/zsh -G 'adm,sudo' dexterp
    - curtin in-target --target /target -- runuser -l dexterp -c 'mkdir -p /home/dexterp/.ssh'
    - curtin in-target --target /target -- runuser -l dexterp -c 'echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJbAJuf9d9F4YynJdtQ/0ZLQhSxVdZAJZa8xZIsS7KJh dexterp@dexterp-p50" >> ~/.ssh/authorized_keys'
    - curtin in-target --target /target -- runuser -l dexterp -c 'chmod 700 /home/dexterp/.ssh'
    - chmod 640 /target/etc/sudoers
    - perl -i -pe 's/^%sudo.*/%sudo ALL=(ALL:ALL) NOPASSWD:ALL/g' /target/etc/sudoers
    - chmod 440 /target/etc/sudoers
    - echo "packer ALL=(ALL) NOPASSWD:ALL" > /target/etc/sudoers.d/packer
    - chmod 440 /target/etc/sudoers.d/packer
