# https://releases.ubuntu.com/26.04/ubuntu-26.04-live-server-amd64.iso

source "qemu" "ubuntu" { 
	iso_url = "https://releases.ubuntu.com/26.04/ubuntu-26.04-live-server-amd64.iso"
	iso_checksum = "sha256:dec49008a71f6098d0bcfc822021f4d042d5f2db279e4d75bdd981304f1ca5d9"
	output_directory = "output"
	format = "qcow2"
	accelerator = "kvm"
	memory = "4096"
	disk_size = "20G"
	cpus = 2
	vm_name = "ubuntu26_04_lts"
	ssh_username = "packer"
	ssh_password = "${password}"
	ssh_port = 22
	cpu_model = "host"
	qemu_binary = "qemu-system-x86_64"
	headless = true
	http_directory = "http"
	ssh_timeout = "40m"
	boot_command = [
    "e<wait>",
    "<down><down><down><end>",
    " autoinstall ds=\"nocloud-net;s=http://{{.HTTPIP}}:{{.HTTPPort}}/\" ",
    "<f10>"
    ]
}

build {
	sources = ["source.qemu.ubuntu"]

	provisioner "file" {
		source = "provisioner/provisioner.sh"
		destination = "/tmp/provisioner.sh"

	}

	provisioner "shell" {
		inline = [
			"chmod +x /tmp/provisioner.sh",
			"sudo /tmp/provisioner.sh",
		]
	}
}